<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mystore.ViewModel"
             x:DataType="vm:ConnexionViewModel"
             x:Class="Mystore.MainPage">

    <ScrollView BackgroundColor="Purple">
        <VerticalStackLayout Spacing="10">
            <Label Text="Connexion" FontAttributes="Bold" FontSize="23"/>
            <Border StrokeShape="10">
                <Entry Placeholder="enter your name" Text="{Binding User}"/>
            </Border>

            <Border StrokeShape="10" >
                <Entry Placeholder="enter your password" Text="{Binding Password}"/>
            </Border>
            
            <VerticalStackLayout Spacing="10">
                <Button Text="Connect" Command="{Binding ConnectCommand}" CornerRadius="10" WidthRequest="250"/>
                <Button Text=" pas de compte ? Cliquez ici " CornerRadius="10" WidthRequest="250"/>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
