<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CGIERP.WinUI.Views.Maui.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mdc="clr-namespace:Material.Components.Maui;assembly=Material.Components.Maui"
    xmlns:syncf="http://schemas.syncfusion.com/maui/toolkit"
    Title="CGI ERP"
    BackgroundColor="#F4F6F8">
    <!--  Soft premium background  -->

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="25">

            <!--  Header Section  -->
            <VerticalStackLayout Spacing="5">
                <Label
                    FontAttributes="Bold"
                    FontSize="28"
                    Text="Bienvenue dans CGI ERP"
                    TextColor="#2C3E50" />
                <Label
                    FontSize="14"
                    Text="Sélectionnez un module pour commencer"
                    TextColor="#7F8C8D" />
            </VerticalStackLayout>

            <!--  Dashboard Cards  -->
            <Grid
                ColumnDefinitions="*, *"
                ColumnSpacing="15"
                RowDefinitions="Auto, Auto"
                RowSpacing="15">

                <!--  QHSE Card  -->
                <mdc:Card
                    Grid.Row="0"
                    Grid.Column="0"
                    HeightRequest="120">
                    <mdc:Card.GestureRecognizers>
                        <TapGestureRecognizer Tapped="GoToQHSEBtn_Clicked" />
                    </mdc:Card.GestureRecognizers>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="10"
                        VerticalOptions="Center">
                        <Label
                            FontSize="32"
                            HorizontalOptions="Center"
                            Text="🛡️" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="QHSE"
                            TextColor="#34495E" />
                    </VerticalStackLayout>
                </mdc:Card>

                <!--  Laboratory Card  -->
                <mdc:Card
                    Grid.Row="0"
                    Grid.Column="1"
                    HeightRequest="120">
                    <mdc:Card.GestureRecognizers>
                        <TapGestureRecognizer Tapped="GoToLaboratory_Clicked" />
                    </mdc:Card.GestureRecognizers>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="10"
                        VerticalOptions="Center">
                        <Label
                            FontSize="32"
                            HorizontalOptions="Center"
                            Text="🔬" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Laboratoire"
                            TextColor="#34495E" />
                    </VerticalStackLayout>
                </mdc:Card>

            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>