<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CGIERP.WinUI.Views.Maui.LaboratoryViews.LabOverView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mdc="clr-namespace:Material.Components.Maui;assembly=Material.Components.Maui"
    xmlns:syncf="http://schemas.syncfusion.com/maui/toolkit"
    Title="Département Laboratoire"
    BackgroundColor="#F4F6F8">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Opérations Métrologiques"
                TextColor="#2C3E50" />

            <mdc:Card Padding="15">

                <Grid ColumnDefinitions="Auto, *">
                    <Label
                        Grid.Column="0"
                        Margin="0,0,15,0"
                        FontSize="40"
                        Text="⚖️"
                        VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <mdc:Button
                           
                            FontColor="#34495E"
                            FontSize="16" Clicked="Button_Clicked"
                            FontWeight="Bold"
                            Text="Vérification des Balances" />
                        <Label
                            FontSize="12"
                            Text="Calcul de l'EMT, Portée Min, et Conformité"
                            TextColor="#7F8C8D" />
                    </VerticalStackLayout>
                </Grid>
            </mdc:Card>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>