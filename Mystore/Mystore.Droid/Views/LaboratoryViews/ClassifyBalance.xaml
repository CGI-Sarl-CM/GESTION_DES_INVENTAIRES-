<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CGIERP.Views.LaboratoryViews.ClassifyBalance"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mdc="clr-namespace:Material.Components.Maui;assembly=Material.Components.Maui"
    xmlns:syncf="http://schemas.syncfusion.com/maui/toolkit"
    xmlns:vm="clr-namespace:CGIERP.ViewModel;assembly=CGRIERP"
    Title="Vérification de Balance"
    x:DataType="vm:LaboratoryViewModel"
    BackgroundColor="#F4F6F8">
    <Grid>
        <ScrollView Padding="15">
            <VerticalStackLayout Spacing="15">

                <!--  SECTION 1: BALANCE SETTINGS  -->
                <mdc:Card Padding="15">
                    <VerticalStackLayout Spacing="15">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="Paramètres de la Balance"
                            TextColor="#2C3E50" />

                        <!--  Max Weight Row  -->
                        <Grid ColumnDefinitions="*, 300" ColumnSpacing="10">
                            <mdc:TextField
                                x:Name="MaxWeightTxt"
                                Grid.Column="0"
                                LabelText="Portée Max (Max)"
                                OutlineColor="DarkSlateBlue"
                                OutlineWidth="1"
                                SupportingText=""
                                Text="{Binding MaximumWeight, Mode=TwoWay}" />
                            <syncf:SfSegmentedControl
                                Grid.Column="1"
                                HeightRequest="56"
                                ItemsSource="{Binding MassUnitsCollection}"
                                SelectedIndex="1"
                                SelectionChanged="MassSegControlMaxWeight_SelectionChanged" />
                        </Grid>

                        <!--  Echelon Row  -->
                        <Grid ColumnDefinitions="*, 300" ColumnSpacing="10">
                            <mdc:TextField
                                x:Name="Echelon"
                                Grid.Column="0"
                                LabelText="Échelon (e / d)"
                                OutlineColor="DarkSlateBlue"
                                OutlineWidth="1"
                                SupportingText=""
                                Text="{Binding EchelonVerif, Mode=TwoWay}" />
                            <syncf:SfSegmentedControl
                                Grid.Column="1"
                                HeightRequest="56"
                                ItemsSource="{Binding MassUnitsCollection}"
                                SelectedIndex="1"
                                SelectionChanged="MassSegControlEchelon_SelectionChanged" />
                        </Grid>
                    </VerticalStackLayout>
                </mdc:Card>

                <!--  SECTION 2: VERIFICATION DATA  -->
                <mdc:Card Padding="15">
                    <VerticalStackLayout Spacing="15">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="Données de Vérification"
                            TextColor="#2C3E50" />

                        <syncf:SfSegmentedControl
                            x:Name="TypeOfVerification"
                            ItemsSource="{Binding VerificationsTypeCollection}"
                            SelectedIndex="0"
                            SelectionChanged="TypeOfVerification_SelectionChanged"
                            ShowSeparator="False">
                            <syncf:SfSegmentedControl.SegmentTemplate>
                                <DataTemplate x:DataType="syncf:SfSegmentItem">
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding Text}"
                                        TextColor="White"
                                        VerticalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsSelected}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger
                                                Binding="{Binding IsSelected}"
                                                TargetType="Label"
                                                Value="False">
                                                <Setter Property="TextColor" Value="Black" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </DataTemplate>
                            </syncf:SfSegmentedControl.SegmentTemplate>
                        </syncf:SfSegmentedControl>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <mdc:TextField
                                x:Name="MassValueText"
                                Grid.Column="0"
                                LabelText="Masse Appliquée (g)"
                                OutlineColor="DarkSlateBlue"
                                OutlineWidth="1"
                                Text="{Binding MassValue, Mode=TwoWay}" />
                            <mdc:TextField
                                x:Name="ErrorValueText"
                                Grid.Column="1"
                                LabelText="Écart Observé (g)"
                                OutlineColor="DarkSlateBlue"
                                OutlineWidth="1"
                                Text="{Binding ErrorValue, Mode=TwoWay}" />
                        </Grid>
                    </VerticalStackLayout>
                </mdc:Card>

                <!--  SECTION 3: ACTION BUTTON & LOADER  -->
                <VerticalStackLayout Margin="0,10" Spacing="10">
                    <mdc:Button
                        x:Name="ClassifyBtn"
                        Command="{Binding DetermineNumberOfEchelonsCommand}"
                        HeightRequest="50"
                        LongPressed="ClassifyBtn_LongPressed"
                        Text="Calculer et Vérifier" />

                    <!--  This spinner only shows when the async command is running!  -->
                    <ActivityIndicator
                        HorizontalOptions="Center"
                        IsRunning="{Binding DetermineNumberOfEchelonsCommand.IsRunning}"
                        IsVisible="{Binding DetermineNumberOfEchelonsCommand.IsRunning}"
                        Color="#3498DB" />
                </VerticalStackLayout>

                <!--  SECTION 4: RESULTS DASHBOARD  -->
                <mdc:Card
                    Padding="20"
                    BackgroundColor="White"
                    HorizontalOptions="Center">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="15">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="Résultats Métrologiques"
                            TextColor="#2C3E50" />
                        <BoxView HeightRequest="1" Color="#E0E0E0" />

                        <Grid
                            ColumnDefinitions="*, *"
                            ColumnSpacing="10"
                            RowDefinitions="Auto, Auto, auto"
                            RowSpacing="15">
                            <!--  Class  -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                <Label
                                    FontSize="12"
                                    Text="Classe de Précision"
                                    TextColor="#7F8C8D" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="{Binding CurrentBalance.ClassNumber, StringFormat='Classe {0}'}"
                                    TextColor="#2C3E50" />
                            </VerticalStackLayout>

                            <!--  Portée Min  -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                <Label
                                    FontSize="12"
                                    Text="Portée Minimale"
                                    TextColor="#7F8C8D" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="{Binding CurrentBalance.MinimumWeight, StringFormat='{0:0.####} g'}"
                                    TextColor="#2C3E50" />
                            </VerticalStackLayout>

                            <!--  EMT  -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                                <Label
                                    FontSize="12"
                                    Text="EMT (Erreur Max)"
                                    TextColor="#7F8C8D" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="{Binding CurrentBalance.EMT, StringFormat='± {0:0.####} g'}"
                                    TextColor="#2C3E50" />
                            </VerticalStackLayout>

                            <!--  Statut  -->
                            <VerticalStackLayout
                                Grid.Row="1"
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                MinimumWidthRequest="150">
                                <Label
                                    FontSize="12"
                                    Text="Statut"
                                    TextColor="#7F8C8D" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="{Binding ConformityStatus}">
                                    <Label.Triggers>
                                        <!--  Dynamic text coloring based on status  -->
                                        <DataTrigger
                                            Binding="{Binding ConformityStatus}"
                                            TargetType="Label"
                                            Value="Conforme">
                                            <Setter Property="TextColor" Value="#27AE60" />
                                            <!--  Green  -->
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding ConformityStatus}"
                                            TargetType="Label"
                                            Value="Non conforme">
                                            <Setter Property="TextColor" Value="#E74C3C" />
                                            <!--  Red  -->
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="3">
                                <Label
                                    FontSize="12"
                                    HorizontalOptions="Center"
                                    Text="Nombre d'Echelons"
                                    TextColor="#7F8C8D" />
                                <Label
                                    Grid.Row="2"
                                    Grid.RowSpan="3"
                                    FontAttributes="Bold"
                                    FontSize="22"
                                    HorizontalOptions="Center"
                                    Text="{Binding CurrentBalance.EchelonNumbers}"
                                    TextColor="#2C3E50" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </mdc:Card>

            </VerticalStackLayout>
        </ScrollView>
        <syncf:SfPopup x:Name="ManualClassificationPopup" HeaderTitle="Forcer la classe">
            <syncf:SfPopup.ContentTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="20">
                        <mdc:ComboBox
                            x:Name="ManualClassificationCmbBox"
                            LabelText="Choisir la classe"
                            MenuBackgroundColor="{Binding BackgroundColor, Source={x:Reference ManualClassificationCmbBox}}"
                            SelectedChanged="ManualClassificationCmbBox_SelectedChanged">
                            <mdc:ComboBox.Items>
                                <mdc:MenuItem BackgroundColor="Green" Text="1" />
                                <mdc:MenuItem Text="2" />
                                <mdc:MenuItem Text="3" />
                                <mdc:MenuItem Text="4" />
                            </mdc:ComboBox.Items>
                        </mdc:ComboBox>
                    </VerticalStackLayout>
                </DataTemplate>
            </syncf:SfPopup.ContentTemplate>
        </syncf:SfPopup>

    </Grid>
</ContentPage>